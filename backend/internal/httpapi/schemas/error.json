{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toefl-prep/api/schemas/error.json",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": ["auth_required", "forbidden", "not_found", "conflict", "validation_failed", "rate_limited", "internal"]
        },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}