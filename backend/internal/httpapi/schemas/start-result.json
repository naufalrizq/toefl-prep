{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toefl-prep/api/schemas/start-result.json",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["attempt", "items"],
      "properties": {
        "attempt": {
          "type": "object",
          "required": ["id", "user_id", "exam_template_id", "mode", "started_at", "status"],
          "properties": {
            "id": { "type": "integer" },
            "user_id": { "type": "integer" },
            "exam_template_id": { "type": "integer" },
            "exam_title": { "type": "string" },
            "mode": { "type": "string", "enum": ["per_question", "overall"] },
            "started_at": { "type": "string" },
            "status": { "type": "string", "enum": ["in_progress", "submitted"] },
            "deadline": { "type": ["string", "null"] }
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "question_snapshot", "flagged"],
            "properties": {
              "id": { "type": "integer" },
              "flagged": { "type": "boolean" },
              "question_snapshot": {
                "type": "object",
                "required": ["question_text", "options", "highlight_regions", "section", "type"],
                "properties": {
                  "question_text": { "type": "string" },
                  "options": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": { "type": "string" }
                  },
                  "explanation": { "type": "string" },
                  "highlight_regions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["start", "end", "pos"],
                      "properties": {
                        "start": { "type": "integer" },
                        "end": { "type": "integer" },
                        "pos": { "type": "string" },
                        "label": { "type": "string" }
                      }
                    }
                  },
                  "section": { "type": "string" },
                  "type": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}